rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidBackup(data, userId) {
      return data.keys().hasAll(['ownerId', 'label', 'totalTasbeeh', 'totalPagesRead', 'currentStreak', 'locksCount', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'label', 'totalTasbeeh', 'totalPagesRead', 'currentStreak', 'locksCount', 'updatedAt'])
        && data.ownerId == userId
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 80
        && data.totalTasbeeh is int && data.totalTasbeeh >= 0
        && data.totalPagesRead is int && data.totalPagesRead >= 0
        && data.currentStreak is int && data.currentStreak >= 0
        && data.locksCount is int && data.locksCount >= 0
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    function isValidCircleCreate(data, circleId) {
      return data.keys().hasAll(['ownerId', 'title', 'inviteCode', 'targetDays', 'totalPagesRead', 'memberUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'inviteCode', 'targetDays', 'totalPagesRead', 'memberUids', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.inviteCode == circleId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.targetDays is int && data.targetDays >= 1 && data.targetDays <= 365
        && data.totalPagesRead is int && data.totalPagesRead >= 0
        && data.memberUids is list && data.memberUids.size() == 1 && request.auth.uid in data.memberUids
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCircleMemberCreate(data, memberUid) {
      return data.keys().hasAll(['uid', 'displayName', 'pagesRead', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'pagesRead', 'joinedAt', 'updatedAt'])
        && data.uid == memberUid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.pagesRead is int && data.pagesRead >= 0 && data.pagesRead <= 60400
        && data.joinedAt is timestamp && data.joinedAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isCircleMember(circleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/circles/$(circleId))
        && (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberUids);
    }

    match /users/{userId}/backups/{backupId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(backupId) && isValidBackup(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    match /circles/{circleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn() && isValidId(circleId) && isValidCircleCreate(request.resource.data, circleId);
      allow update: if isSignedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt <= request.time
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 30
        && (
          (
            !(request.auth.uid in resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.auth.uid in request.resource.data.memberUids
          )
          ||
          (
            (request.auth.uid in resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPagesRead', 'updatedAt'])
            && request.resource.data.totalPagesRead is int
            && request.resource.data.totalPagesRead >= resource.data.totalPagesRead
          )
          ||
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'targetDays', 'totalPagesRead', 'memberUids', 'updatedAt'])
            && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
            && request.resource.data.targetDays is int && request.resource.data.targetDays >= 1 && request.resource.data.targetDays <= 365
            && request.resource.data.totalPagesRead is int && request.resource.data.totalPagesRead >= 0
          )
        );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isOwner(memberUid) || isCircleMember(circleId);
        allow create: if isOwner(memberUid) && isCircleMember(circleId) && isValidCircleMemberCreate(request.resource.data, memberUid);
        allow update: if isOwner(memberUid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'pagesRead', 'updatedAt'])
          && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 60
          && request.resource.data.pagesRead is int && request.resource.data.pagesRead >= 0 && request.resource.data.pagesRead <= 60400
          && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt <= request.time;
        allow delete: if isOwner(memberUid)
          || (isSignedIn() && get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
