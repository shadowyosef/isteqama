<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasbeeh_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tasbeeh_phrase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"
            android:textColor="#A5D6A7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_tasbeeh_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="تصفير"
            android:textColor="#FFCC80"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_tasbeeh_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="فتح"
            android:textColor="#81C784"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_tasbeeh_tap_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_chip"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tasbeeh_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tasbeeh_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اضغط للتسبيح • الهدف: 33"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/pb_tasbeeh_goal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:max="33"
            android:progress="0"
            android:progressTint="#34D399" />
    </LinearLayout>

    <!-- Shown when widget is resized larger -->
    <LinearLayout
        android:id="@+id/widget_tasbeeh_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_tasbeeh_daily_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="إجمالي اليوم: 0"
            android:textColor="#FFE082"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="3">
            <TextView android:id="@+id/btn_tasbeeh_quick_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_widget_chip" android:gravity="center" android:maxLines="1" android:paddingVertical="4dp" android:text="سبحان الله" android:textColor="#FFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/btn_tasbeeh_quick_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@drawable/bg_widget_chip" android:gravity="center" android:maxLines="1" android:paddingVertical="4dp" android:text="أستغفر الله" android:textColor="#FFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/btn_tasbeeh_quick_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/bg_widget_chip" android:gravity="center" android:maxLines="1" android:paddingVertical="4dp" android:text="الصلاة عالنبي" android:textColor="#FFFFFF" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_tasbeeh_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="السابق"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_tasbeeh_index"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1 / 5"
            android:textColor="#A5D6A7"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_tasbeeh_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="التالي"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
